[Unit]
Description=vLLM test server - unsloth/Qwen3.8-27B-NVFP4 (spark-1, .venv-vllm-0271)
After=network-online.target nvidia-persistenced.service
Wants=network-online.target

[Service]
Type=simple
User=mjbernaski
WorkingDirectory=/home/mjbernaski/projects/gemma4

Environment=CUDA_HOME=/usr/local/cuda-13.0
Environment=FLASHINFER_CUDA_ARCH_LIST=12.1a
Environment=CUTE_DSL_ARCH=sm_121a
Environment=PATH=/home/mjbernaski/projects/gemma4/.venv-vllm-0271/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HF_HUB_DISABLE_XET=1
Environment=MAX_JOBS=4
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=90
Environment=FLASHINFER_DISABLE_VERSION_CHECK=1

# Same flags as serve_qwen38_27b_nvfp4_test.sh, but run in the foreground
# (no nohup/disown) so systemd can track and restart the process directly.
ExecStart=/home/mjbernaski/projects/gemma4/.venv-vllm-0271/bin/vllm serve unsloth/Qwen3.8-27B-NVFP4 \
  --served-model-name qwen3.8-27b \
  --host 0.0.0.0 --port 8899 \
  --trust-remote-code \
  --tensor-parallel-size 1 \
  --kv-cache-dtype fp8 \
  --max-model-len 262144 \
  --max-num-seqs 4 \
  --gpu-memory-utilization 0.65 \
  --limit-mm-per-prompt '{"image": 4}' \
  --mm-processor-kwargs '{"max_pixels": 262144}' \
  --enable-chunked-prefill \
  --enable-prefix-caching \
  --async-scheduling \
  --enable-auto-tool-choice \
  --tool-call-parser qwen3_xml \
  --max-cudagraph-capture-size 16 \
  --speculative-config '{"method":"mtp","num_speculative_tokens":3}'

Restart=on-failure
RestartSec=10
TimeoutStartSec=600
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
