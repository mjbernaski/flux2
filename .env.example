# FLUX Server Configuration
# Copy this to .env and set your values

# MANDATORY: Set a strong API key to secure your server
# The server will NOT start without this!
FLUX_API_KEY=your_secret_key_here

# Port to run the server on (default 2222)
PORT=2222

# Vision model for /critique, /describe and /boost. OLLAMA_URL is the VLM
# endpoint: either a local ollama daemon (the default) or an OpenAI-compatible
# server such as vLLM or llama.cpp, on this box or another one — the dialect is
# detected automatically (force it with VLM_API=ollama|openai). Running the VLM
# off-box keeps the local card free for the diffusion pipeline.
# OLLAMA_URL=http://127.0.0.1:11434
# CRITIQUE_MODEL=qwen3.6:latest
# DESCRIBE_MODEL=qwen3.6:latest
#
# ...or against a remote OpenAI-compatible server. CRITIQUE_MODEL must name a
# model that endpoint actually serves (see GET <url>/v1/models).
# OLLAMA_URL=http://192.168.5.40:8899
# CRITIQUE_MODEL=qwen3-vl-235b
# DESCRIBE_MODEL=qwen3-vl-235b

# Status note board. The server posts a short status line (config, model
# state, image/job counters, queue depth, last error) every NOTE_INTERVAL
# seconds. The board holds one note and each post replaces it, so this is a
# status line rather than a log; prompt text is never included. Failures are
# non-fatal and logged once. Set NOTE_URL=off to disable.
# NOTE_URL=http://127.0.0.1:9999/note
# NOTE_INTERVAL=300
